@page
@model OverlayModel

@{
    Layout = "_OverlayLayout";
}

<style>

    :root {
        --tile-start: @Model.Appearance.TileColor;
        --tile-end: @Model.Appearance.TileColorEnd;
        --done-start: @Model.Appearance.CompletedColor;
        --done-end: @Model.Appearance.CompletedColorEnd;
        --tile-text: @Model.Appearance.TextColor;
        --radius: @(Model.Appearance.BorderRadius) px;
        --size: @(Model.Appearance.TileSize) px;
    }

</style>
<div id="overlay-container">
    <div class="bingo">

        @foreach (var tile in Model.Tiles)
        {
            <div class="tile @(tile.Completed ? "done" : "")"
                 data-id="@tile.Id">

                @tile.Text

            </div>
        }

    </div>
</div>


<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@latest/dist/browser/signalr.min.js"></script>

<script src="~/js/overlay.js" asp-append-version="true"></script>