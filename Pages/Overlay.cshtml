@page
@model OverlayModel

@{
    Layout = "_OverlayLayout";
}


<div class="bingo">

    @foreach (var tile in Model.Tiles)
    {
        <div class="tile @(tile.Completed ? "done" : "")"
             data-id="@tile.Id">

            @tile.Text

        </div>
    }

</div>


<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@latest/dist/browser/signalr.min.js"></script>


<script>

    const connection =
        new signalR.HubConnectionBuilder()
            .withUrl("/bingoHub")
            .build();


    connection.on(
        "TileUpdated",
        function(id, completed) {
            const tile =
                document.querySelector(
                    `[data-id='${id}']`
                );


            if (tile) {
                tile.classList.toggle(
                    "done",
                    completed
                );
            }
        });


    connection.on(
        "TileTextUpdated",
        function(id, text) {
            const tile =
                document.querySelector(
                    `[data-id='${id}']`
                );


            if (tile) {
                tile.innerText = text;
            }
        });


    connection.on(
        "BoardReset",
        function() {
            console.log("Bingo reset");


            document
                .querySelectorAll(".tile")
                .forEach(tile => {
                    tile.classList.remove("done");
                });
        });


    connection.start()
        .then(() => {
            console.log("SignalR connected");
        })
        .catch(err => {
            console.error(err);
        });

</script>